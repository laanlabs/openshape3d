# Xcode
xcuserdata/
DerivedData/
*.xccheckout
*.moved-aside
*.xcuserstate

# Swift Package Manager
.build/

# macOS
.DS_Store

.claude/*
# …except the project skill, which is part of the repo: it documents the agent
# bridge in `openshape3d/Agent/` and is useless to a teammate who cannot see it.
# Personal settings and settings.local.json stay ignored by the line above.
!.claude/skills/

# OCCT B-rep port: the prebuilt OCCT.xcframework is committed via Git LFS (its
# two static libs are tracked by .gitattributes) so a fresh checkout builds
# without running scripts/build_occt_ios.sh. Only the local build scratch dir
# is ignored.
.occt-build/

# App Store / website capture output (not source)
marketing/

# Xcode derived data used by the local test/build gate
build/

# Firebase CLI's local deploy cache (firebase.json / .firebaserc / firebase/*.rules
# ARE committed — they hold no secrets).
.firebase/
firebase-debug.log

# Firebase project config for the in-app bug reporter (API key, project ID,
# storage bucket). Never committed — drop your own copy at this path; without
# it the bug-report sheet explains that reporting isn't configured. A
# placeholder to copy from lives at docs/GoogleService-Info.example.plist.
openshape3d/GoogleService-Info.plist
